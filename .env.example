# Non-secret configuration template for AI Stack.
# Copy to .env and edit on the FCOS host:
#   cp .env.example .env
# Never commit the real .env file.

# Physical interface Suricata listens on. Confirm with: ip -br link
SURICATA_INTERFACE=enp1s0

# Dedicated, deliberately-scoped scan target for ClamAV and AIDE.
# Do not point this at / or pseudo-filesystems.
SCAN_TARGET_PATH=/var/lib/ai-stack/scan-target
