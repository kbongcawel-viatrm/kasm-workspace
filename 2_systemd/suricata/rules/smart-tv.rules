alert dns any any -> any any (msg:"IPFire DBL [Smart TV] Blocked DNS Query"; dns.query; domain; dataset:isset,smart-tv,type string,load datasets/smart-tv.txt; classtype:policy-violation; priority:4; sid:12002101; rev:1; reference:url,https://www.ipfire.org/dbl/smart-tv; metadata:dbl smart-tv.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Smart TV] Blocked HTTP Request"; http.host; domain; dataset:isset,smart-tv,type string,load datasets/smart-tv.txt; classtype:policy-violation; priority:4; sid:12002102; rev:1; reference:url,https://www.ipfire.org/dbl/smart-tv; metadata:dbl smart-tv.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Smart TV] Blocked TLS Connection"; tls.sni; domain; dataset:isset,smart-tv,type string,load datasets/smart-tv.txt; classtype:policy-violation; priority:4; sid:12002103; rev:1; reference:url,https://www.ipfire.org/dbl/smart-tv; metadata:dbl smart-tv.dbl.ipfire.org;)
