alert dns any any -> any any (msg:"IPFire DBL [Advertising] Blocked DNS Query"; dns.query; domain; dataset:isset,ads,type string,load datasets/ads.txt; classtype:policy-violation; priority:3; sid:12001501; rev:1; reference:url,https://www.ipfire.org/dbl/ads; metadata:dbl ads.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Advertising] Blocked HTTP Request"; http.host; domain; dataset:isset,ads,type string,load datasets/ads.txt; classtype:policy-violation; priority:3; sid:12001502; rev:1; reference:url,https://www.ipfire.org/dbl/ads; metadata:dbl ads.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Advertising] Blocked TLS Connection"; tls.sni; domain; dataset:isset,ads,type string,load datasets/ads.txt; classtype:policy-violation; priority:3; sid:12001503; rev:1; reference:url,https://www.ipfire.org/dbl/ads; metadata:dbl ads.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Advertising] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,ads,type string,load datasets/ads.txt; classtype:policy-violation; priority:3; sid:12001504; rev:1; reference:url,https://www.ipfire.org/dbl/ads; metadata:dbl ads.dbl.ipfire.org;)
