alert dns any any -> any any (msg:"IPFire DBL [Piracy] Blocked DNS Query"; dns.query; domain; dataset:isset,piracy,type string,load datasets/piracy.txt; classtype:policy-violation; priority:2; sid:12002001; rev:1; reference:url,https://www.ipfire.org/dbl/piracy; metadata:dbl piracy.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Piracy] Blocked HTTP Request"; http.host; domain; dataset:isset,piracy,type string,load datasets/piracy.txt; classtype:policy-violation; priority:2; sid:12002002; rev:1; reference:url,https://www.ipfire.org/dbl/piracy; metadata:dbl piracy.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Piracy] Blocked TLS Connection"; tls.sni; domain; dataset:isset,piracy,type string,load datasets/piracy.txt; classtype:policy-violation; priority:2; sid:12002003; rev:1; reference:url,https://www.ipfire.org/dbl/piracy; metadata:dbl piracy.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Piracy] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,piracy,type string,load datasets/piracy.txt; classtype:policy-violation; priority:2; sid:12002004; rev:1; reference:url,https://www.ipfire.org/dbl/piracy; metadata:dbl piracy.dbl.ipfire.org;)
