alert dns any any -> any any (msg:"IPFire DBL [Streaming] Blocked DNS Query"; dns.query; domain; dataset:isset,streaming,type string,load datasets/streaming.txt; classtype:policy-violation; priority:4; sid:12002501; rev:1; reference:url,https://www.ipfire.org/dbl/streaming; metadata:dbl streaming.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Streaming] Blocked HTTP Request"; http.host; domain; dataset:isset,streaming,type string,load datasets/streaming.txt; classtype:policy-violation; priority:4; sid:12002502; rev:1; reference:url,https://www.ipfire.org/dbl/streaming; metadata:dbl streaming.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Streaming] Blocked TLS Connection"; tls.sni; domain; dataset:isset,streaming,type string,load datasets/streaming.txt; classtype:policy-violation; priority:4; sid:12002503; rev:1; reference:url,https://www.ipfire.org/dbl/streaming; metadata:dbl streaming.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Streaming] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,streaming,type string,load datasets/streaming.txt; classtype:policy-violation; priority:4; sid:12002504; rev:1; reference:url,https://www.ipfire.org/dbl/streaming; metadata:dbl streaming.dbl.ipfire.org;)
