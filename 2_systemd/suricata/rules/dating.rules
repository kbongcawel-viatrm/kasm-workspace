alert dns any any -> any any (msg:"IPFire DBL [Dating] Blocked DNS Query"; dns.query; domain; dataset:isset,dating,type string,load datasets/dating.txt; classtype:policy-violation; priority:2; sid:12001701; rev:1; reference:url,https://www.ipfire.org/dbl/dating; metadata:dbl dating.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Dating] Blocked HTTP Request"; http.host; domain; dataset:isset,dating,type string,load datasets/dating.txt; classtype:policy-violation; priority:2; sid:12001702; rev:1; reference:url,https://www.ipfire.org/dbl/dating; metadata:dbl dating.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Dating] Blocked TLS Connection"; tls.sni; domain; dataset:isset,dating,type string,load datasets/dating.txt; classtype:policy-violation; priority:2; sid:12001703; rev:1; reference:url,https://www.ipfire.org/dbl/dating; metadata:dbl dating.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Dating] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,dating,type string,load datasets/dating.txt; classtype:policy-violation; priority:2; sid:12001704; rev:1; reference:url,https://www.ipfire.org/dbl/dating; metadata:dbl dating.dbl.ipfire.org;)
