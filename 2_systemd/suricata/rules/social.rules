alert dns any any -> any any (msg:"IPFire DBL [Social Networks] Blocked DNS Query"; dns.query; domain; dataset:isset,social,type string,load datasets/social.txt; classtype:policy-violation; priority:2; sid:12000801; rev:1; reference:url,https://www.ipfire.org/dbl/social; metadata:dbl social.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Social Networks] Blocked HTTP Request"; http.host; domain; dataset:isset,social,type string,load datasets/social.txt; classtype:policy-violation; priority:2; sid:12000802; rev:1; reference:url,https://www.ipfire.org/dbl/social; metadata:dbl social.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Social Networks] Blocked TLS Connection"; tls.sni; domain; dataset:isset,social,type string,load datasets/social.txt; classtype:policy-violation; priority:2; sid:12000803; rev:1; reference:url,https://www.ipfire.org/dbl/social; metadata:dbl social.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Social Networks] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,social,type string,load datasets/social.txt; classtype:policy-violation; priority:2; sid:12000804; rev:1; reference:url,https://www.ipfire.org/dbl/social; metadata:dbl social.dbl.ipfire.org;)
