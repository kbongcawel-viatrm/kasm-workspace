alert dns any any -> any any (msg:"IPFire DBL [Shopping] Blocked DNS Query"; dns.query; domain; dataset:isset,shopping,type string,load datasets/shopping.txt; classtype:policy-violation; priority:4; sid:12002401; rev:1; reference:url,https://www.ipfire.org/dbl/shopping; metadata:dbl shopping.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Shopping] Blocked HTTP Request"; http.host; domain; dataset:isset,shopping,type string,load datasets/shopping.txt; classtype:policy-violation; priority:4; sid:12002402; rev:1; reference:url,https://www.ipfire.org/dbl/shopping; metadata:dbl shopping.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Shopping] Blocked TLS Connection"; tls.sni; domain; dataset:isset,shopping,type string,load datasets/shopping.txt; classtype:policy-violation; priority:4; sid:12002403; rev:1; reference:url,https://www.ipfire.org/dbl/shopping; metadata:dbl shopping.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Shopping] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,shopping,type string,load datasets/shopping.txt; classtype:policy-violation; priority:4; sid:12002404; rev:1; reference:url,https://www.ipfire.org/dbl/shopping; metadata:dbl shopping.dbl.ipfire.org;)
