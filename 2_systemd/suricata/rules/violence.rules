alert dns any any -> any any (msg:"IPFire DBL [Violence] Blocked DNS Query"; dns.query; domain; dataset:isset,violence,type string,load datasets/violence.txt; classtype:policy-violation; priority:2; sid:12001601; rev:1; reference:url,https://www.ipfire.org/dbl/violence; metadata:dbl violence.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Violence] Blocked HTTP Request"; http.host; domain; dataset:isset,violence,type string,load datasets/violence.txt; classtype:policy-violation; priority:2; sid:12001602; rev:1; reference:url,https://www.ipfire.org/dbl/violence; metadata:dbl violence.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Violence] Blocked TLS Connection"; tls.sni; domain; dataset:isset,violence,type string,load datasets/violence.txt; classtype:policy-violation; priority:2; sid:12001603; rev:1; reference:url,https://www.ipfire.org/dbl/violence; metadata:dbl violence.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Violence] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,violence,type string,load datasets/violence.txt; classtype:policy-violation; priority:2; sid:12001604; rev:1; reference:url,https://www.ipfire.org/dbl/violence; metadata:dbl violence.dbl.ipfire.org;)
