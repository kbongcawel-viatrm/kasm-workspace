alert dns any any -> any any (msg:"IPFire DBL [Phishing] Blocked DNS Query"; dns.query; domain; dataset:isset,phishing,type string,load datasets/phishing.txt; classtype:policy-violation; priority:1; sid:12001901; rev:1; reference:url,https://www.ipfire.org/dbl/phishing; metadata:dbl phishing.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Phishing] Blocked HTTP Request"; http.host; domain; dataset:isset,phishing,type string,load datasets/phishing.txt; classtype:policy-violation; priority:1; sid:12001902; rev:1; reference:url,https://www.ipfire.org/dbl/phishing; metadata:dbl phishing.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Phishing] Blocked TLS Connection"; tls.sni; domain; dataset:isset,phishing,type string,load datasets/phishing.txt; classtype:policy-violation; priority:1; sid:12001903; rev:1; reference:url,https://www.ipfire.org/dbl/phishing; metadata:dbl phishing.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Phishing] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,phishing,type string,load datasets/phishing.txt; classtype:policy-violation; priority:1; sid:12001904; rev:1; reference:url,https://www.ipfire.org/dbl/phishing; metadata:dbl phishing.dbl.ipfire.org;)
