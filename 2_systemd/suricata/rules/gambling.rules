alert dns any any -> any any (msg:"IPFire DBL [Gambling] Blocked DNS Query"; dns.query; domain; dataset:isset,gambling,type string,load datasets/gambling.txt; classtype:policy-violation; priority:2; sid:12001001; rev:1; reference:url,https://www.ipfire.org/dbl/gambling; metadata:dbl gambling.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Gambling] Blocked HTTP Request"; http.host; domain; dataset:isset,gambling,type string,load datasets/gambling.txt; classtype:policy-violation; priority:2; sid:12001002; rev:1; reference:url,https://www.ipfire.org/dbl/gambling; metadata:dbl gambling.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Gambling] Blocked TLS Connection"; tls.sni; domain; dataset:isset,gambling,type string,load datasets/gambling.txt; classtype:policy-violation; priority:2; sid:12001003; rev:1; reference:url,https://www.ipfire.org/dbl/gambling; metadata:dbl gambling.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Gambling] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,gambling,type string,load datasets/gambling.txt; classtype:policy-violation; priority:2; sid:12001004; rev:1; reference:url,https://www.ipfire.org/dbl/gambling; metadata:dbl gambling.dbl.ipfire.org;)
