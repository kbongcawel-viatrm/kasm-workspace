alert dns any any -> any any (msg:"IPFire DBL [Games] Blocked DNS Query"; dns.query; domain; dataset:isset,games,type string,load datasets/games.txt; classtype:policy-violation; priority:4; sid:12002201; rev:1; reference:url,https://www.ipfire.org/dbl/games; metadata:dbl games.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [Games] Blocked HTTP Request"; http.host; domain; dataset:isset,games,type string,load datasets/games.txt; classtype:policy-violation; priority:4; sid:12002202; rev:1; reference:url,https://www.ipfire.org/dbl/games; metadata:dbl games.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [Games] Blocked TLS Connection"; tls.sni; domain; dataset:isset,games,type string,load datasets/games.txt; classtype:policy-violation; priority:4; sid:12002203; rev:1; reference:url,https://www.ipfire.org/dbl/games; metadata:dbl games.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [Games] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,games,type string,load datasets/games.txt; classtype:policy-violation; priority:4; sid:12002204; rev:1; reference:url,https://www.ipfire.org/dbl/games; metadata:dbl games.dbl.ipfire.org;)
