alert dns any any -> any any (msg:"IPFire DBL [DNS-over-HTTPS] Blocked DNS Query"; dns.query; domain; dataset:isset,doh,type string,load datasets/doh.txt; classtype:policy-violation; priority:2; sid:12001401; rev:1; reference:url,https://www.ipfire.org/dbl/doh; metadata:dbl doh.dbl.ipfire.org;)
alert http any any -> any any (msg:"IPFire DBL [DNS-over-HTTPS] Blocked HTTP Request"; http.host; domain; dataset:isset,doh,type string,load datasets/doh.txt; classtype:policy-violation; priority:2; sid:12001402; rev:1; reference:url,https://www.ipfire.org/dbl/doh; metadata:dbl doh.dbl.ipfire.org;)
alert tls any any -> any any (msg:"IPFire DBL [DNS-over-HTTPS] Blocked TLS Connection"; tls.sni; domain; dataset:isset,doh,type string,load datasets/doh.txt; classtype:policy-violation; priority:2; sid:12001403; rev:1; reference:url,https://www.ipfire.org/dbl/doh; metadata:dbl doh.dbl.ipfire.org;)
alert quic any any -> any any (msg:"IPFire DBL [DNS-over-HTTPS] Blocked QUIC Connection"; quic.sni; domain; dataset:isset,doh,type string,load datasets/doh.txt; classtype:policy-violation; priority:2; sid:12001404; rev:1; reference:url,https://www.ipfire.org/dbl/doh; metadata:dbl doh.dbl.ipfire.org;)
