[Unit]
Description=Scan Secureblue writable locations with ClamAV
Documentation=https://docs.clamav.net/manual/Usage/Scanning.html
After=clamav-freshclam.service local-fs.target
ConditionPathExists=/usr/bin/clamscan

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/clam-scan.sh
User=root
Group=root
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0027
